# Mail delivery for password recovery and email verification
RECALL_PUBLIC_BASE_URL=https://your-recall-domain.example
RECALL_SMTP_HOST=smtp.example.com
RECALL_SMTP_PORT=587
RECALL_SMTP_USERNAME=your-smtp-username
RECALL_SMTP_PASSWORD=your-smtp-password
RECALL_EMAIL_FROM=no-reply@example.com
RECALL_SMTP_USE_SSL=0
RECALL_SMTP_STARTTLS=1

# OAuth sign-in (register apps and use the exact callback URLs from the setup guide)
RECALL_GITHUB_CLIENT_ID=
RECALL_GITHUB_CLIENT_SECRET=
RECALL_YANDEX_CLIENT_ID=
RECALL_YANDEX_CLIENT_SECRET=
